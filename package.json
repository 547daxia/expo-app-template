{
  "name": "expo-app-template",
  "version": "0.0.4",
  "private": true,
  "packageManager": "pnpm@10.12.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/547daxia/expo-app-template.git"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prebuild": "pnpm expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 expo export",
    "xcode": "xed -b ios",
    "doctor": "pnpm dlx expo-doctor@1.20.1",
    "preinstall": "npx only-allow pnpm",
    "start:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run start",
    "prebuild:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "prebuild:development": "cross-env EXPO_PUBLIC_APP_ENV=development STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "android:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run android",
    "ios:preview": "cross-env EXPO_PUBLIC_APP_ENV=preview pnpm run ios",
    "start:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 pnpm run start",
    "prebuild:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 pnpm run prebuild",
    "android:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 pnpm run android",
    "ios:production": "cross-env EXPO_PUBLIC_APP_ENV=production STRICT_ENV_VALIDATION=1 pnpm run ios",
    "build:development:ios": "pnpm dlx eas-cli@21.4.0 build --profile development --platform ios",
    "build:development:android": "pnpm dlx eas-cli@21.4.0 build --profile development --platform android",
    "build:preview:ios": "pnpm dlx eas-cli@21.4.0 build --profile preview --platform ios",
    "build:preview:android": "pnpm dlx eas-cli@21.4.0 build --profile preview --platform android",
    "build:production:ios": "cross-env STRICT_ENV_VALIDATION=1 pnpm dlx eas-cli@21.4.0 build --profile production --platform ios",
    "build:production:android": "cross-env STRICT_ENV_VALIDATION=1 pnpm dlx eas-cli@21.4.0 build --profile production --platform android",
    "prepare": "husky",
    "app-release": "cross-env SKIP_BRANCH_PROTECTION=true np --no-publish --no-cleanup --no-release-draft",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noemit",
    "test": "jest",
    "docs:build": "pnpm --dir docs build",
    "audit:prod": "pnpm audit --prod --audit-level=low",
    "audit:ci": "pnpm run audit:prod && pnpm audit --audit-level=high",
    "check-all": "pnpm run lint && pnpm run type-check && pnpm run test:ci && pnpm run audit:ci && pnpm exec expo install --check && pnpm run doctor",
    "test:ci": "jest --coverage --runInBand && pnpm run test:cli",
    "test:cli": "node --test cli/test/*.test.js",
    "test:watch": "pnpm run test --watch",
    "install-maestro": "export MAESTRO_VERSION=2.4.0 && curl -fsSL 'https://get.maestro.mobile.dev' | bash",
    "e2e-test": "pnpm run e2e-test:development",
    "e2e-test:development": "maestro test .maestro/ -e APP_ID=com.example.mobileapp.development",
    "e2e-test:preview": "maestro test .maestro/ -e APP_ID=com.example.mobileapp.preview"
  },
  "dependencies": {
    "@dev-plugins/react-query": "0.4.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/html-elements": "^57.0.0",
    "@expo/metro-runtime": "^56.0.18",
    "@expo/vector-icons": "^15.1.1",
    "@gluestack-ui/core": "5.0.15",
    "@gluestack-ui/utils": "5.0.6",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@legendapp/motion": "2.5.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "expo": "~56.0.18",
    "expo-constants": "~56.0.22",
    "expo-crypto": "^56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-document-picker": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.22",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.17",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.2",
    "react-native": "0.85.3",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-keyboard-controller": "^1.21.6",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "~4.1.1",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "~15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "^0.8.3",
    "react-query-kit": "^3.3.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "uniwind": "^1.2.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@expo/config": "~56.0.13",
    "@isaacs/brace-expansion": "^5.0.1",
    "@tailwindcss/cli": "^4.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/invariant": "^2.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.18",
    "axios-mock-adapter": "^2.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "jest-junit": "^17.0.0",
    "lint-staged": "^16.2.7",
    "np": "^10.3.0",
    "tailwindcss": "4.1.18",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    }
  },
  "pnpm": {
    "overrides": {
      "@tootallnate/once@2.0.0": "2.0.1",
      "@xmldom/xmldom": "0.8.13",
      "ajv@8.17.1": "8.20.0",
      "brace-expansion@1.1.12": "1.1.18",
      "brace-expansion@2.0.2": "2.1.4",
      "fast-uri@3.1.0": "3.1.5",
      "flatted": "3.4.4",
      "follow-redirects@1.15.11": "1.16.0",
      "js-yaml@3.14.2": "3.15.0",
      "js-yaml@4.1.1": "4.3.1",
      "linkify-it": "5.0.2",
      "lodash@4.17.21": "4.18.1",
      "markdown-it": "14.2.0",
      "minimatch@3.1.2": "3.1.4",
      "minimatch@3.1.3": "3.1.4",
      "minimatch@8.0.4": "8.0.7",
      "minimatch@9.0.5": "9.0.9",
      "node-forge@1.3.3": "1.4.0",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.5",
      "shell-quote@1.8.3": "1.10.0",
      "tmp@0.0.33": "0.2.7",
      "uuid@7.0.3": "11.1.1",
      "ws@7.5.10": "7.5.13",
      "ws@8.19.0": "8.21.1",
      "yaml@2.8.2": "2.9.0"
    }
  }
}
