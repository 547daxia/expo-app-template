# Select one of: development, preview, production
EXPO_PUBLIC_APP_ENV=development

# Required client-visible API endpoint. Do not put secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_API_URL=https://api.example.com

# Optional associated domain used by Expo configuration.
# EXPO_PUBLIC_ASSOCIATED_DOMAIN=https://example.com

# Template values used to verify number and boolean environment parsing.
EXPO_PUBLIC_VAR_NUMBER=0
EXPO_PUBLIC_VAR_BOOL=false

# Available only while evaluating app.config.ts; do not expose secrets with EXPO_PUBLIC_*.
# APP_BUILD_ONLY_VAR=
