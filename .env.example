# Select one of: development, preview, production
EXPO_PUBLIC_APP_ENV=development

# Expo account and project metadata are evaluated only in app.config.ts.
# Set these before using EAS Build or EAS Update; do not reuse another project's ID.
# EXPO_ACCOUNT_OWNER=your-expo-account-or-organization
EXPO_SLUG=mobile-app
# EAS_PROJECT_ID=

# Required client-visible API endpoint. DummyJSON keeps the development demo
# usable, but production validation rejects this demo endpoint. Replace it with
# your own HTTPS API before a production prebuild or EAS build.
EXPO_PUBLIC_API_URL=https://dummyjson.com

# Optional public website or store listing shown in Settings and Share.
# EXPO_PUBLIC_APP_URL=https://example.com

# Optional token-refresh endpoint override. Defaults to <EXPO_PUBLIC_API_URL>/auth/refresh.
# EXPO_PUBLIC_AUTH_REFRESH_URL=https://api.example.com/auth/refresh

# Optional validated value for projects that add associated-domain handling.
# The template does not consume it in app.config.ts by default.
# EXPO_PUBLIC_ASSOCIATED_DOMAIN=https://example.com

# Template values used to verify number and boolean environment parsing.
EXPO_PUBLIC_VAR_NUMBER=0
EXPO_PUBLIC_VAR_BOOL=false

# Available only while evaluating app.config.ts; do not expose secrets with EXPO_PUBLIC_*.
# APP_BUILD_ONLY_VAR=
